# 배포 URL (끝에 / 없이). sitemap, robots, metadataBase에 사용
NEXT_PUBLIC_SITE_URL=https://example.com

# Google Analytics 4 측정 ID (G-XXXXXXXXXX). 비우면 GA를 로드하지 않음
NEXT_PUBLIC_GA_ID=

# 검색엔진 소유 확인 meta 태그 값 (content 속성 값만). 비우면 태그를 출력하지 않음
GOOGLE_SITE_VERIFICATION=
NAVER_SITE_VERIFICATION=

# Google AdSense 게시자 ID (ca-pub-0000000000000000). 비우면 애드센스 스크립트·메타 태그·ads.txt를 출력하지 않음
NEXT_PUBLIC_ADSENSE_CLIENT=
# 결과 화면 디스플레이 광고 단위 ID (숫자). 비우면 광고 자리를 그리지 않음
NEXT_PUBLIC_ADSENSE_SLOT_RESULT=
